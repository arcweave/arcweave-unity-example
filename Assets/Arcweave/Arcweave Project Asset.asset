    - rid: 9198629236872577094
      type: {class: Board, ns: Arcweave.Project, asm: Assembly-CSharp}
      data:
        <Id>k__BackingField: 1c11fa2a-f76c-4be7-aac4-6bf92a63240f
        <Name>k__BackingField: Healer Dialogue
        <Nodes>k__BackingField:
        - rid: 9198629236872577122
        - rid: 9198629236872577123
        - rid: 9198629236872577124
        - rid: 9198629236872577125
